{
  "dashboard": {
    "id": null,
    "uid": null,
    "title": "Monitoramento Edge AI — Raspberry Pi 5",
    "tags": ["edge-ai", "yolo-edge-api", "aula7"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 0,
    "refresh": "10s",
    "time": { "from": "now-15m", "to": "now" },
    "panels": [
      {
        "id": 1,
        "title": "Carga de Processamento",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
        "targets": [
          {
            "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
            "expr": "node_load1",
            "legendFormat": "CPU Load",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "Uso de RAM (%)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
        "targets": [
          {
            "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
            "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100",
            "legendFormat": "Uso de RAM",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Temperatura da CPU (°C)",
        "type": "gauge",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
        "fieldConfig": {
          "defaults": {
            "unit": "celsius",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 60 },
                { "color": "red", "value": 80 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
            "expr": "max(node_hwmon_temp_celsius{chip=\"thermal_thermal_zone0\"})",
            "legendFormat": "Temperatura da CPU",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Tempo de Inferência do YOLO (s)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
        "targets": [
          {
            "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
            "expr": "yolo_inference_time_seconds",
            "legendFormat": "inferência",
            "refId": "A"
          }
        ]
      }
    ]
  },
  "overwrite": false
}
